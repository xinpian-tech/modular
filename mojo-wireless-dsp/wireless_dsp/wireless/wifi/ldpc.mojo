def wifi_ldpc_sparse_graph(profile: WifiLDPCProfile) raises -> WifiLDPCGraph:
    """Expand a WLAN QC base matrix into a row-wise sparse binary graph."""
    _validate_wifi_ldpc_profile(profile)
    var shifts = wifi_ldpc_base_shifts(profile)
    var offsets = List[Int](capacity=profile.parity_length + 1)
    var columns = List[Int]()
    offsets.append(0)
    for block_row in range(profile.block_rows):
        for local_row in range(profile.lifting_size):
            for block_column in range(24):
                var shift = shifts[block_row * 24 + block_column]
                if shift >= 0:
                    columns.append(
                        block_column * profile.lifting_size
                        + (local_row + shift) % profile.lifting_size
                    )
            offsets.append(len(columns))
    return WifiLDPCGraph(offsets^, columns^)


def wifi_ldpc_syndrome_ok(
    codeword: Span[UInt8, ...], profile: WifiLDPCProfile
) raises -> Bool:
    _validate_wifi_ldpc_profile(profile)
    if len(codeword) != profile.block_length:
        raise Error("Wi-Fi LDPC codeword has the wrong length")
    var graph = wifi_ldpc_sparse_graph(profile)
    return syndrome_ok(
        Span(codeword), Span(graph.row_offsets), Span(graph.columns)
    )


def _packed_bit(
    matrix: Span[UInt64, ...], words: Int, row: Int, column: Int
) -> Bool:
    return (
        (matrix[row * words + column // 64] >> UInt64(column % 64)) & UInt64(1)
    ) != 0


def wifi_ldpc_encode(
    information: Span[UInt8, ...], profile: WifiLDPCProfile
) raises -> List[UInt8]:
    """Systematically encode one complete WLAN mother-code information block."""
    _validate_wifi_ldpc_profile(profile)
    if len(information) != profile.information_length:
        raise Error("Wi-Fi LDPC information block has the wrong length")
    for i in range(len(information)):
        if information[i] > 1:
            raise Error("Wi-Fi LDPC input must be binary")

    var shifts = wifi_ldpc_base_shifts(profile)
    var m = profile.parity_length
    var words = (m + 63) // 64
    var packed = List[UInt64](length=m * words, fill=UInt64(0))
    var rhs = List[UInt8](length=m, fill=UInt8(0))
    for block_row in range(profile.block_rows):
        for local_row in range(profile.lifting_size):
            var row = block_row * profile.lifting_size + local_row
            for block_column in range(24):
                var shift = shifts[block_row * 24 + block_column]
                if shift < 0:
                    continue
                var column = (
                    block_column * profile.lifting_size
                    + (local_row + shift) % profile.lifting_size
                )
                if column < profile.information_length:
                    rhs[row] ^= information[column]
                else:
                    var parity_column = column - profile.information_length
                    packed[row * words + parity_column // 64] |= UInt64(
                        1
                    ) << UInt64(parity_column % 64)

    var pivot_columns = List[Int](length=m, fill=-1)
    var pivot_row = 0
    for column in range(m):
        var found = -1
        for row in range(pivot_row, m):
            if _packed_bit(Span(packed), words, row, column):
                found = row
                break
        if found < 0:
            continue
        if found != pivot_row:
            for word in range(words):
                var temporary = packed[pivot_row * words + word]
                packed[pivot_row * words + word] = packed[found * words + word]
                packed[found * words + word] = temporary
            var rhs_temporary = rhs[pivot_row]
            rhs[pivot_row] = rhs[found]
            rhs[found] = rhs_temporary
        for row in range(pivot_row + 1, m):
            if _packed_bit(Span(packed), words, row, column):
                for word in range(words):
                    packed[row * words + word] ^= packed[
                        pivot_row * words + word
                    ]
                rhs[row] ^= rhs[pivot_row]
        pivot_columns[pivot_row] = column
        pivot_row += 1
    if pivot_row != m:
        raise Error("Wi-Fi LDPC parity submatrix is singular")

    var parity = List[UInt8](length=m, fill=UInt8(0))
    for reverse_index in range(m):
        var row = m - reverse_index - 1
        var column = pivot_columns[row]
        var value = rhs[row]
        for later in range(column + 1, m):
            if _packed_bit(Span(packed), words, row, later):
                value ^= parity[later]
        parity[column] = value

    var result = List[UInt8](capacity=profile.block_length)
    for i in range(len(information)):
        result.append(information[i])
    for bit in parity:
        result.append(bit)
    if not wifi_ldpc_syndrome_ok(Span(result), profile):
        raise Error("internal Wi-Fi LDPC encoder syndrome failure")
    return result^


def wifi_ldpc_decode(
    llrs: Span[Float64, ...],
    profile: WifiLDPCProfile,
    *,
    max_iterations: Int = 20,
    normalization: Float64 = 0.75,
    offset: Float64 = 0.0,
    clip: Float64 = 50.0,
) raises -> WifiLDPCDecodeResult:
    """Decode one complete WLAN mother code; positive LLR denotes bit zero."""
    _validate_wifi_ldpc_profile(profile)
    if len(llrs) != profile.block_length:
        raise Error("Wi-Fi LDPC LLR block has the wrong length")
    var graph = wifi_ldpc_sparse_graph(profile)
    var decoded = ldpc_decode_min_sum(
        llrs,
        Span(graph.row_offsets),
        Span(graph.columns),
        max_iterations=max_iterations,
        normalization=normalization,
        offset=offset,
        clip=clip,
    )
    var information = List[UInt8](capacity=profile.information_length)
    for i in range(profile.information_length):
        information.append(decoded.bits[i])
    var iterations = decoded.iterations
    var converged = decoded.converged
    var codeword = decoded.bits.copy()
    return WifiLDPCDecodeResult(information^, codeword^, iterations, converged)


def wifi_ldpc_rate_match_block(
    information: Span[UInt8, ...],
    profile: WifiLDPCProfile,
    *,
    shortened_bits: Int = 0,
    punctured_bits: Int = 0,
    repeated_bits: Int = 0,
) raises -> List[UInt8]:
    """Encode and apply WLAN shortening, parity puncturing, and repetition.

    ``information`` contains K-S transmitted information bits.  The S known
    zeros are appended before systematic encoding and removed afterwards.
    P bits are removed from the right end of the parity field.  R transmitted
    bits are repeated cyclically from the leftmost systematic bit.
    """
    _validate_wifi_ldpc_profile(profile)
    var k = profile.information_length
    var m = profile.parity_length
    if shortened_bits < 0 or shortened_bits > k:
        raise Error("invalid Wi-Fi LDPC shortening count")
    if punctured_bits < 0 or punctured_bits > m:
        raise Error("invalid Wi-Fi LDPC puncturing count")
    if repeated_bits < 0 or len(information) != k - shortened_bits:
        raise Error("Wi-Fi LDPC rate-matching information length mismatch")
    var full_information = List[UInt8](capacity=k)
    for i in range(len(information)):
        full_information.append(information[i])
    for _ in range(shortened_bits):
        full_information.append(UInt8(0))
    var codeword = wifi_ldpc_encode(Span(full_information), profile)
    var result = List[UInt8](
        capacity=profile.block_length
        - shortened_bits
        - punctured_bits
        + repeated_bits
    )
    for i in range(k - shortened_bits):
        result.append(codeword[i])
    for i in range(m - punctured_bits):
        result.append(codeword[k + i])
    var base_length = len(result)
    if repeated_bits > 0 and base_length == 0:
        raise Error("cannot repeat an empty Wi-Fi LDPC block")
    for i in range(repeated_bits):
        result.append(result[i % base_length])
    return result^


def wifi_ldpc_rate_recover_block(
    llrs: Span[Float64, ...],
    profile: WifiLDPCProfile,
    *,
    shortened_bits: Int = 0,
    punctured_bits: Int = 0,
    repeated_bits: Int = 0,
    shortened_llr: Float64 = 50.0,
) raises -> List[Float64]:
    """Invert WLAN LDPC rate matching into one full mother-code LLR block."""
    _validate_wifi_ldpc_profile(profile)
    var k = profile.information_length
    var m = profile.parity_length
    var base_length = profile.block_length - shortened_bits - punctured_bits
    if (
        shortened_bits < 0
        or shortened_bits > k
        or punctured_bits < 0
        or punctured_bits > m
        or repeated_bits < 0
        or not isfinite(shortened_llr)
        or shortened_llr <= 0.0
        or len(llrs) != base_length + repeated_bits
    ):
        raise Error("invalid Wi-Fi LDPC rate-recovery configuration")
    var result = List[Float64](length=profile.block_length, fill=0.0)
    for index in range(len(llrs)):
        if not isfinite(llrs[index]):
            raise Error("Wi-Fi LDPC rate-recovery LLRs must be finite")
    var source = 0
    for i in range(k - shortened_bits):
        result[i] = llrs[source]
        source += 1
    for i in range(k - shortened_bits, k):
        result[i] = shortened_llr
    for i in range(m - punctured_bits):
        result[k + i] = llrs[source]
        source += 1
    for repeat_index in range(repeated_bits):
        var base_index = repeat_index % base_length
        var target = (
            base_index if base_index
            < k - shortened_bits else base_index + shortened_bits
        )
        result[target] += llrs[source + repeat_index]
        if not isfinite(result[target]):
            raise Error("Wi-Fi LDPC rate-recovery accumulation overflowed")
    return result^
