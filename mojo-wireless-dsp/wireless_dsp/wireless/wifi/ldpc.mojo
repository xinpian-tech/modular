"""IEEE 802.11 HT/VHT/HE/EHT QC-LDPC construction and rate matching.

The twelve base matrices below are the WLAN matrices from IEEE Std 802.11:
24 block columns, lifting sizes 27/54/81, and rates 1/2, 2/3,
3/4, and 5/6.  A non-negative base entry is a right-circulant permutation
whose expanded row ``r`` has its one in column ``(r + shift) mod Z``.

Encoding is a readable systematic GF(2) reference implementation.  It solves
the square parity submatrix with bit-packed Gaussian elimination; the decoder
reuses the protocol-independent normalized min-sum engine.  WLAN shortening,
puncturing, and repetition stay here so they cannot be confused with NR rate
matching.
"""

from std.collections import Span
from std.math import isfinite
from wireless_dsp.fec.ldpc import ldpc_decode_min_sum, syndrome_ok


struct WifiLDPCProfile(Movable):
    var block_length: Int
    var information_length: Int
    var parity_length: Int
    var lifting_size: Int
    var block_rows: Int
    var rate_numerator: Int
    var rate_denominator: Int

    def __init__(
        out self,
        block_length: Int,
        information_length: Int,
        parity_length: Int,
        lifting_size: Int,
        block_rows: Int,
        rate_numerator: Int,
        rate_denominator: Int,
    ):
        self.block_length = block_length
        self.information_length = information_length
        self.parity_length = parity_length
        self.lifting_size = lifting_size
        self.block_rows = block_rows
        self.rate_numerator = rate_numerator
        self.rate_denominator = rate_denominator


struct WifiLDPCGraph(Movable):
    var row_offsets: List[Int]
    var columns: List[Int]

    def __init__(out self, var row_offsets: List[Int], var columns: List[Int]):
        self.row_offsets = row_offsets^
        self.columns = columns^


struct WifiLDPCDecodeResult(Movable):
    var information_bits: List[UInt8]
    var codeword_bits: List[UInt8]
    var iterations: Int
    var converged: Bool

    def __init__(
        out self,
        var information_bits: List[UInt8],
        var codeword_bits: List[UInt8],
        iterations: Int,
        converged: Bool,
    ):
        self.information_bits = information_bits^
        self.codeword_bits = codeword_bits^
        self.iterations = iterations
        self.converged = converged


def wifi_ldpc_profile(
    block_length: Int, rate_numerator: Int, rate_denominator: Int
) raises -> WifiLDPCProfile:
    """Return one of the twelve WLAN mother-code profiles."""
    if block_length != 648 and block_length != 1296 and block_length != 1944:
        raise Error("Wi-Fi LDPC block length must be 648, 1296, or 1944")
    var block_rows: Int
    if rate_numerator == 1 and rate_denominator == 2:
        block_rows = 12
    elif rate_numerator == 2 and rate_denominator == 3:
        block_rows = 8
    elif rate_numerator == 3 and rate_denominator == 4:
        block_rows = 6
    elif rate_numerator == 5 and rate_denominator == 6:
        block_rows = 4
    else:
        raise Error("Wi-Fi LDPC rate must be 1/2, 2/3, 3/4, or 5/6")
    var lifting = block_length // 24
    var parity = block_rows * lifting
    return WifiLDPCProfile(
        block_length,
        block_length - parity,
        parity,
        lifting,
        block_rows,
        rate_numerator,
        rate_denominator,
    )


def _validate_wifi_ldpc_profile(profile: WifiLDPCProfile) raises:
    """Reject forged or subsequently mutated WLAN LDPC profile fields."""
    var expected = wifi_ldpc_profile(
        profile.block_length,
        profile.rate_numerator,
        profile.rate_denominator,
    )
    if (
        profile.information_length != expected.information_length
        or profile.parity_length != expected.parity_length
        or profile.lifting_size != expected.lifting_size
        or profile.block_rows != expected.block_rows
    ):
        raise Error("Wi-Fi LDPC profile fields are inconsistent")


def wifi_ldpc_base_shifts(profile: WifiLDPCProfile) raises -> List[Int]:
    """Return a row-major block_rows by 24 shift table; -1 is a zero block."""
